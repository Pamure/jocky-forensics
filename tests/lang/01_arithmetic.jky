# Arithmetic and numeric behaviour. Every expectation here is a promise the
# language makes to a script author.

expect(2 + 3 * 4, 14, "precedence: multiplication binds tighter")
expect((2 + 3) * 4, 20, "parentheses override precedence")
expect(10 - 4 - 3, 3, "subtraction is left associative")
expect(10 / 4, 2.5, "'/' is true division")
expect(10 / 2, 5.0, "even division still yields a float")
expect(7 % 3, 1, "modulo of positives")
expect(-7 % 3, 2, "modulo follows the divisor's sign")
expect(-5 + 3, -2, "unary minus with addition")
expect(2 * -3, -6, "unary minus binds to its operand")
expect(1 + 2 * 3 - 4 / 2, 5.0, "mixed expression")

assert(1 < 2, "less-than")
assert(2 <= 2, "less-or-equal")
assert(3 > 2, "greater-than")
assert(3 >= 4 == false, "greater-or-equal chains left, so this is (3 >= 4) == false")
assert(1 == 1.0, "int and float compare numerically")
expect(0.1 + 0.2 == 0.3, false, "floats are IEEE doubles, not decimals")

# literal forms
expect(0x1f, 31, "hexadecimal literal")
expect(0b101, 5, "binary literal")
expect(1_000, 1000, "underscores are ignored in numbers")

# 64-bit integers are not truncated
expect(9007199254740993 + 0, 9007199254740993, "integers are arbitrary precision")

# division by zero is a catchable error, not a crash (see 07_errors.jky)
expect_throws(fn() { return 1 / 0 }, "division by zero raises")
expect_throws(fn() { return 1 % 0 }, "modulo by zero raises")
